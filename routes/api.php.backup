<?php

use Illuminate\Support\Facades\Route;
use App\Http\Controllers\Api\V1\AuthController;
use App\Http\Controllers\Api\V1\ProjectController;
use App\Http\Controllers\Api\V1\TaskController;
use App\Http\Controllers\Api\V1\TeamController;
use App\Http\Controllers\Api\V1\UserManagementController;
use App\Http\Controllers\Api\V1\SubscriptionController;

/*
|--------------------------------------------------------------------------
| API Routes
|--------------------------------------------------------------------------
*/

Route::prefix('v1')->group(function () {
    
    // Auth routes (public)
    Route::post('/auth/register', [AuthController::class, 'register']);
    Route::post('/auth/login', [AuthController::class, 'login']);
    Route::post('/auth/logout', [AuthController::class, 'logout'])->middleware('auth:sanctum');
    Route::get('/auth/me', [AuthController::class, 'me'])->middleware('auth:sanctum');
    Route::put('/auth/update', [AuthController::class, 'update'])->middleware('auth:sanctum');
    
    // Protected routes
    Route::middleware('auth:sanctum')->group(function () {
        
        // Subscription routes
        Route::get('/subscription/current', [SubscriptionController::class, 'current']);
        Route::get('/subscription/plans', [SubscriptionController::class, 'plans']);
        
        // Projects
        Route::apiResource('/projects', ProjectController::class);
        Route::get('/projects/{id}/tasks', [ProjectController::class, 'tasks']);
        
        // Tasks
        Route::apiResource('/tasks', TaskController::class);
        
        // Teams
        Route::apiResource('/teams', TeamController::class);
        
        // Users
        Route::get('/users', [UserManagementController::class, 'index']);
        Route::post('/users', [UserManagementController::class, 'store']);
        Route::get('/users/{id}', [UserManagementController::class, 'show']);
        Route::put('/users/{id}', [UserManagementController::class, 'update']);
        Route::delete('/users/{id}', [UserManagementController::class, 'destroy']);

    });
	//Kanban Routes
	Route::middleware(['auth:sanctum'])->prefix('v1')->group(function () {
    Route::get('/kanban/{projectId}', [App\Http\Controllers\Api\V1\KanbanController::class, 'getBoard']);
    Route::post('/kanban/move', [App\Http\Controllers\Api\V1\KanbanController::class, 'moveTask']);
    Route::post('/kanban/columns', [App\Http\Controllers\Api\V1\KanbanController::class, 'createColumn']);
    Route::put('/kanban/columns/{id}', [App\Http\Controllers\Api\V1\KanbanController::class, 'updateColumn']);
    Route::delete('/kanban/columns/{id}', [App\Http\Controllers\Api\V1\KanbanController::class, 'deleteColumn']);
});

});
