<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Http\Requests\Api\V1\Company\StoreCompanyRequest;
use App\Http\Requests\Api\V1\Company\UpdateCompanyRequest;
use App\Http\Resources\Api\V1\CompanyResource;
use App\Models\Company;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Log;

class CompanyController extends Controller
{
    public function index()
    {
        try {
            Log::info('CompanyController@index called', [
                'user_id' => Auth::id(),
                'user_role' => Auth::user()?->role
            ]);

            if (Auth::user()->role !== 'super_admin' && Auth::user()->role !== 'admin') {
                return response()->json(['message' => 'Unauthorized - Admin only'], 403);
            }

            $companies = Company::with('creator')->paginate(15);
            
            return CompanyResource::collection($companies);
        } catch (\Exception $e) {
            Log::error('CompanyController@index error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function store(Request $request)
    {
        try {
            Log::info('CompanyController@store called', [
                'user_id' => Auth::id(),
                'user_role' => Auth::user()?->role,
                'request_data' => $request->all()
            ]);

            // Check if user is admin or super_admin
            if (Auth::user()->role !== 'super_admin' && Auth::user()->role !== 'admin') {
                return response()->json(['message' => 'Unauthorized - Admin only'], 403);
            }

            // Validate manually
            $validated = $request->validate([
                'name' => 'required|string|max:255',
                'email' => 'required|email|unique:companies,email',
                'subdomain' => 'nullable|string|max:100|unique:companies,subdomain',
                'phone' => 'nullable|string|max:30',
                'address' => 'nullable|string',
                'website' => 'nullable|string|max:255',
                'industry' => 'nullable|string|max:50',
                'plan' => 'nullable|in:free,pro,enterprise',
                'status' => 'nullable|in:active,suspended,trial',
            ]);

            $company = Company::create([
                'name' => $validated['name'],
                'email' => $validated['email'],
                'subdomain' => $validated['subdomain'] ?? null,
                'phone' => $validated['phone'] ?? null,
                'address' => $validated['address'] ?? null,
                'website' => $validated['website'] ?? null,
                'industry' => $validated['industry'] ?? null,
                'plan' => $validated['plan'] ?? 'free',
                'status' => $validated['status'] ?? 'active',
                'created_by' => Auth::id(),
            ]);

            Log::info('Company created successfully', ['company_id' => $company->id]);

            return response()->json([
                'data' => new CompanyResource($company),
                'message' => 'Company created successfully'
            ], 201);

        } catch (\Illuminate\Validation\ValidationException $e) {
            Log::error('CompanyController@store validation error: ' . json_encode($e->errors()));
            return response()->json([
                'message' => 'Validation failed',
                'errors' => $e->errors()
            ], 422);
        } catch (\Exception $e) {
            Log::error('CompanyController@store error: ' . $e->getMessage(), [
                'file' => $e->getFile(),
                'line' => $e->getLine()
            ]);
            return response()->json([
                'message' => 'Server Error: ' . $e->getMessage()
            ], 500);
        }
    }

    public function show(Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin' && Auth::user()->role !== 'admin' && Auth::user()->company_id !== $company->id) {
                return response()->json(['message' => 'Unauthorized'], 403);
            }

            return new CompanyResource($company->load('creator'));
        } catch (\Exception $e) {
            Log::error('CompanyController@show error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function update(UpdateCompanyRequest $request, Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin' && Auth::user()->role !== 'admin') {
                return response()->json(['message' => 'Unauthorized - Admin only'], 403);
            }

            $company->update($request->validated());
            return new CompanyResource($company);
        } catch (\Exception $e) {
            Log::error('CompanyController@update error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function destroy(Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin') {
                return response()->json(['message' => 'Unauthorized - Super Admin only'], 403);
            }

            $company->delete();
            return response()->json(['message' => 'Company deleted successfully']);
        } catch (\Exception $e) {
            Log::error('CompanyController@destroy error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function activate(Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin') {
                return response()->json(['message' => 'Unauthorized - Super Admin only'], 403);
            }

            $company->update(['status' => 'active']);
            return response()->json(['message' => 'Company activated successfully']);
        } catch (\Exception $e) {
            Log::error('CompanyController@activate error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function suspend(Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin') {
                return response()->json(['message' => 'Unauthorized - Super Admin only'], 403);
            }

            $company->update(['status' => 'suspended']);
            return response()->json(['message' => 'Company suspended successfully']);
        } catch (\Exception $e) {
            Log::error('CompanyController@suspend error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }

    public function users(Company $company)
    {
        try {
            if (Auth::user()->role !== 'super_admin' && Auth::user()->role !== 'admin' && Auth::user()->company_id !== $company->id) {
                return response()->json(['message' => 'Unauthorized'], 403);
            }

            return response()->json($company->users);
        } catch (\Exception $e) {
            Log::error('CompanyController@users error: ' . $e->getMessage());
            return response()->json([
                'message' => 'Server Error',
                'debug' => $e->getMessage()
            ], 500);
        }
    }
}
